{
  "name": "vsnt.vera",
  "version": "1.0.0",
  "description": "VeRA Vendor Registration Application — SAP Fiori / BTP Workzone",
  "private": true,
  "scripts": {
    "start":         "fiori run --open 'index.html'",
    "start-mock":    "fiori run --open 'index-mock.html'",
    "build":         "cd .. && ui5 build --config=webapp/ui5.yaml --clean-dest --dest webapp/dist",
    "deploy":        "npm run build && cf deploy dist/vsnt.vera.zip",
    "deploy-config": "fiori add deploy-config",
    "lint":          "eslint ."
  },
  "devDependencies": {
    "@sap/ux-ui5-tooling": "latest",
    "@ui5/cli": "^3.0.0",
    "eslint": "^8.0.0"
  },
  "ui5": {
    "dependencies": [
      "@sap/ux-ui5-tooling"
    ]
  },
  "sapux": true
}
