<mvc:View
    controllerName="vsnt.vera.controller.Home"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:f="sap.f">

    <Page
        id="homePage"
        title="{i18n>appTitle}"
        titleAlignment="Center"
        backgroundDesign="List">

        <content>
            <f:GridContainer
                class="sapUiLargeMargin"
                snapToRow="true">

                <f:layout>
                    <f:GridContainerSettings rowSize="5rem" columnSize="5rem" gap="1rem"/>
                </f:layout>

                <GenericTile
                    header="{i18n>btnRegister}"
                    subheader="{i18n>homeRegisterDesc}"
                    press=".onNavRegister"
                    frameType="TwoByOne">
                    <TileContent>
                        <ImageContent src="sap-icon://add-document"/>
                    </TileContent>
                    <layoutData>
                        <f:GridContainerItemLayoutData minRows="2" columns="4"/>
                    </layoutData>
                </GenericTile>

                <GenericTile
                    header="{i18n>btnMaintain}"
                    subheader="{i18n>homeMaintainDesc}"
                    press=".onNavMaintain"
                    visible="false"
                    frameType="TwoByOne">
                    <TileContent>
                        <ImageContent src="sap-icon://edit"/>
                    </TileContent>
                    <layoutData>
                        <f:GridContainerItemLayoutData minRows="2" columns="4"/>
                    </layoutData>
                </GenericTile>

                <GenericTile
                    header="{i18n>btnStatus}"
                    subheader="{i18n>homeStatusDesc}"
                    visible="false"
                    press=".onNavStatus"
                    frameType="TwoByOne">
                    <TileContent>
                        <ImageContent src="sap-icon://status-in-process"/>
                    </TileContent>
                    <layoutData>
                        <f:GridContainerItemLayoutData minRows="2" columns="4"/>
                    </layoutData>
                </GenericTile>

            </f:GridContainer>
        </content>

    </Page>

</mvc:View>
