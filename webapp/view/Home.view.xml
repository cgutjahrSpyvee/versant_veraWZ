<mvc:View
    controllerName="vsnt.vera.controller.Home"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m">

    <Page
        id="homePage"
        title="{i18n>appTitle}"
        titleAlignment="Center"
        backgroundDesign="List">

        <content>

            <!-- A registration can only start from an invitation, so the invite
                 list is the whole home screen: it carries the status and is the
                 way into the wizard.

                 Bound to the whole set; the Open/All segment below narrows it
                 with a binding filter on status/open, which is what used to be
                 a second page. -->
            <Table
                id="invitesTable"
                items="{inbox>/items}"
                mode="SingleSelectMaster"
                itemPress=".onInvitePress"
                growing="true"
                growingThreshold="20"
                busy="{inbox>/busy}"
                width="auto"
                class="sapUiResponsiveMargin">

                <noData>
                    <!-- Base size: text only. The illustration art does not
                         render here, and any larger size reserves its blank
                         area above the title. -->
                    <!-- illustrationType is a plain string, not an enum, so it
                         needs the full "<set>-<type>" value. UI5 splits it on
                         the dash; a bare "NoTasks" leaves the type undefined
                         and throws while rendering, taking the page with it. -->
                    <IllustratedMessage
                        illustrationType="sapIllus-NoTasks"
                        illustrationSize="Base"
                        title="{= ${inbox>/filter} === 'all' ? ${i18n>noRequestsTitle} : ${i18n>noOpenInvitesTitle} }"/>
                </noData>

                <headerToolbar>
                    <Toolbar>
                        <Title text="{i18n>myRequests}" level="H2"/>
                        <ToolbarSpacer/>
                        <!-- Open hides the settled requests (completed,
                             cancelled, registered); All shows everything the
                             backend returned. -->
                        <SegmentedButton
                            id="inviteFilter"
                            selectedKey="{inbox>/filter}"
                            selectionChange=".onInviteFilterChange">
                            <items>
                                <SegmentedButtonItem key="open" text="{i18n>filterOpen}"/>
                                <SegmentedButtonItem key="all"  text="{i18n>filterAll}"/>
                            </items>
                        </SegmentedButton>
                        <!-- TEST ONLY — impersonate another user's email so the
                             invite list can be checked without re-signing-in. -->
                        <Button
                            id="btnTestEmail"
                            icon="sap-icon://email"
                            text="{i18n>btnTestEmail}"
                            tooltip="{i18n>btnTestEmail}"
                            press=".onChangeTestEmail"
                            type="Transparent"/>
                        <Button
                            icon="sap-icon://refresh"
                            tooltip="{i18n>btnRefresh}"
                            press=".onRefreshInvites"
                            type="Transparent"/>
                    </Toolbar>
                </headerToolbar>

                <columns>
                    <Column><Text text="{i18n>requestId}"/></Column>
                    <Column><Text text="{i18n>vendorName}"/></Column>
                    <Column
                        minScreenWidth="Tablet"
                        demandPopin="true"
                        popinDisplay="Inline">
                        <Text text="{i18n>status}"/>
                    </Column>
                    <Column
                        minScreenWidth="Desktop"
                        demandPopin="true"
                        popinDisplay="Inline">
                        <Text text="{i18n>lastUpdated}"/>
                    </Column>
                </columns>

                <items>
                    <ColumnListItem type="Navigation">
                        <cells>
                            <!-- reqId is REQST, joined in from vadminData; the
                                 invitation's own id is inbox>id. -->
                            <ObjectIdentifier title="{inbox>reqId}" text="{inbox>type}"/>
                            <Text text="{inbox>name}"/>
                            <!-- The backend's notes on the request (IT_EMSG)
                                 hang off the status they explain — a count
                                 here, the text itself in a popover — so the
                                 row stays one line and the status badge stays
                                 the only coloured thing in it. Sitting in this
                                 cell, the link travels with the status into
                                 the popin on a phone.

                                 A Link marks its own press event, so opening
                                 the popover does not also fire itemPress and
                                 navigate into the wizard. -->
                            <VBox>
                                <ObjectStatus
                                    text="{inbox>status/text}"
                                    state="{inbox>status/state}"/>
                                <Link
                                    text="{ path: 'inbox>messageCount', formatter: '.formatMessageCount' }"
                                    visible="{= ${inbox>messageCount} > 0 }"
                                    press=".onShowMessages"/>
                            </VBox>
                            <Text text="{inbox>date}"/>
                        </cells>
                    </ColumnListItem>
                </items>
            </Table>
        </content>

        <!-- Build identity, so a user can say exactly what they are looking at.
             Text is set in Home.controller.onInit from model/appInfo.js. -->
        <footer>
            <OverflowToolbar>
                <ToolbarSpacer/>
                <Button
                    id="appVersionButton"
                    type="Transparent"
                    icon="sap-icon://information"
                    tooltip="{i18n>aboutTooltip}"
                    press=".onShowAppInfo"/>
            </OverflowToolbar>
        </footer>

    </Page>

</mvc:View>
