<mvc:View
    controllerName="vsnt.vera.controller.Status"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:f="sap.ui.layout.form"
    xmlns:core="sap.ui.core">

    <Page
        id="statusPage"
        title="{i18n>statusPageTitle}"
        showNavButton="true"
        navButtonPress=".onNavHome"
        busy="{inbox>/busy}">

        <content>

            <!-- No status hero here: after submit the user is sent straight
                 back to this list, and each row already carries its own status. -->
            <Panel
                headerText="{i18n>myRequests}"
                visible="{= ${inbox>/items}.length > 0}">

                <Table
                    id="inboxTable"
                    items="{inbox>/items}"
                    growing="true"
                    growingThreshold="20"
                    noDataText="{i18n>noRequests}">

                    <columns>
                        <Column><Text text="{i18n>requestId}"/></Column>
                        <Column><Text text="{i18n>vendorName}"/></Column>
                        <Column><Text text="{i18n>status}"/></Column>
                        <Column><Text text="{i18n>lastUpdated}"/></Column>
                    </columns>

                    <items>
                        <ColumnListItem>
                            <cells>
                                <ObjectIdentifier title="{inbox>id}"/>
                                <Text text="{inbox>name}"/>
                                <ObjectStatus
                                    text="{inbox>status/text}"
                                    state="{inbox>status/state}"/>
                                <Text text="{inbox>date}"/>
                            </cells>
                        </ColumnListItem>
                    </items>
                </Table>
            </Panel>

           <!-- <IllustratedMessage
                illustrationType="NoData"
                title="{i18n>noRequestsTitle}"
                description="{i18n>noRequestsDescription}"
                visible="{= ${inbox>/items}.length === 0 &amp;&amp; !${inbox>/busy}}">
                <additionalContent>
                    <Button
                        text="{i18n>btnRegister}"
                        press=".onNavRegister"
                        type="Emphasized"
                        icon="sap-icon://add"/>
                </additionalContent>
            </IllustratedMessage>
            -->
            
        </content>
    </Page>

</mvc:View>
