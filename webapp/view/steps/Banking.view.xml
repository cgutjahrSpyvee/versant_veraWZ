<mvc:View
    controllerName="vsnt.vera.controller.steps.Banking"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:f="sap.ui.layout.form"
    xmlns:u="sap.ui.unified"
    xmlns:core="sap.ui.core">

    <VBox class="sapUiMediumMargin">

        <f:SimpleForm
            title="{i18n>primaryAccount}"
            editable="{reg>/ui/editable}"
            layout="ResponsiveGridLayout"
            labelSpanXL="4" labelSpanL="4" labelSpanM="4" labelSpanS="12"
            adjustLabelSpan="false"
            columnsXL="2" columnsL="2" columnsM="1">

            <f:content>
                <Label text="{i18n>paymentMethod}" required="true"/>
                <!-- Which methods are offered depends on the vendor type — see
                     model/paymentMethods.js, filled by Banking.controller. -->
                <SegmentedButton
                    id="primaryMethodToggle"
                    selectedKey="{reg>/banking/primaryAccount/method}"
                    enabled="{= ${reg>/ui/editable} &amp;&amp; !${reg>/ui/paymentMethodLocked} }"
                    selectionChange=".onPrimaryMethodChange"
                    items="{reg>/ui/paymentMethods}">
                    <items>
                        <SegmentedButtonItem key="{reg>key}" text="{reg>text}"/>
                    </items>
                </SegmentedButton>

                <!-- Bank country - hidden for US-only scope, will be re-enabled for international -->
                <Label text="{i18n>bankCountry}" required="true" visible="false"/>
                <Select id="primaryCountry" selectedKey="{reg>/banking/primaryAccount/country}"
                        change=".onBankingFieldChange" visible="false"
                        enabled="{= ${reg>/ui/editable} &amp;&amp; ${reg>/ui/bankCountryEditable} }">
                    <items>
                        <core:Item key="US"    text="United States"/>
                        <core:Item key="CA"    text="Canada"/>
                        <core:Item key="GB"    text="United Kingdom"/>
                        <core:Item key="MX"    text="Mexico"/>
                        <core:Item key="AU"    text="Australia"/>
                        <core:Item key="NZ"    text="New Zealand"/>
                        <core:Item key="OTHER" text="Other"/>
                    </items>
                </Select>

                <Label text="{i18n>bankRoutingNum}" required="true"
                       visible="{= ${reg>/banking/primaryAccount/method} !== 'Check'}"/>
                <Input
                    id="primaryRouting"
                    value="{reg>/banking/primaryAccount/routingNum}"
                    valueState="{= ${reg>/ui/bankingTouched} &amp;&amp; ${reg>/banking/primaryAccount/method} !== 'Check' &amp;&amp; !${reg>/banking/primaryAccount/routingNum} ? 'Error' : 'None'}"
                    valueStateText="Routing Number is required"
                    maxLength="9"
                    visible="{= ${reg>/banking/primaryAccount/method} !== 'Check'}"
                    editable="{reg>/ui/editable}"
                    liveChange=".onBankingFieldChange"/>

                <Label text="{i18n>bankAccountNum}" required="true"
                       visible="{= ${reg>/banking/primaryAccount/method} !== 'Check'}"/>
                <Input
                    id="primaryAccountNum"
                    value="{reg>/banking/primaryAccount/accountNum}"
                    valueState="{= ${reg>/ui/bankingTouched} &amp;&amp; ${reg>/banking/primaryAccount/method} !== 'Check' &amp;&amp; !${reg>/banking/primaryAccount/accountNum} ? 'Error' : 'None'}"
                    valueStateText="Account Number is required"
                    maxLength="17"
                    visible="{= ${reg>/banking/primaryAccount/method} !== 'Check'}"
                    editable="{reg>/ui/editable}"
                    liveChange=".onBankingFieldChange"/>

                <Label text="{i18n>accountHolderName}" required="true"
                       visible="{= ${reg>/banking/primaryAccount/method} !== 'Check'}"/>
                <Input
                    id="primaryHolderName"
                    value="{reg>/banking/primaryAccount/holderName}"
                    valueState="{= ${reg>/ui/bankingTouched} &amp;&amp; ${reg>/banking/primaryAccount/method} !== 'Check' &amp;&amp; !${reg>/banking/primaryAccount/holderName} ? 'Error' : 'None'}"
                    valueStateText="Account Holder Name is required"
                    visible="{= ${reg>/banking/primaryAccount/method} !== 'Check'}"
                    editable="{reg>/ui/editable}"
                    liveChange=".onBankingFieldChange"/>

                <Label text="{i18n>uploadBankDetailsForm}"/>
                <HBox alignItems="Center">
                    <u:FileUploader
                        id="primaryBankFileUploader"
                        name="bankDetails"
                        visible="{reg>/ui/editable}"
                        fileType="pdf,jpg,png"
                        maximumFileSize="10"
                        change=".onPrimaryBankFileChange"
                        buttonText="{i18n>chooseFile}"/>
                    <ObjectStatus
                        text="{reg>/banking/primaryAccount/bankFileName}"
                        state="Success"
                        icon="sap-icon://document"
                        visible="{= !!${reg>/banking/primaryAccount/bankFileName}}"
                        class="sapUiSmallMarginBegin"/>
                </HBox>

                <Label text=""/>
                <Link
                    id="bankFormDownloadLink"
                    text="{i18n>downloadBlankForm}"
                    target="_blank"/>
            </f:content>
        </f:SimpleForm>

        <Panel headerText="{i18n>secondaryAccounts}" expandable="true" expanded="false">

            <headerToolbar>
                <OverflowToolbar>
                    <Title text="{i18n>secondaryAccounts}" level="H3"/>
                    <ToolbarSpacer/>
                    <Button icon="sap-icon://add" tooltip="{i18n>btnAddAccount}"
                            press=".onAddSecondaryAccount" type="Transparent"
                            visible="{reg>/ui/editable}"/>
                </OverflowToolbar>
            </headerToolbar>

            <List
                id="secondaryAccountList"
                items="{reg>/banking/secondaryAccounts}"
                noDataText="{i18n>noSecondaryAccounts}"
                showSeparators="Inner">
                <CustomListItem>
                    <f:SimpleForm
                        editable="{reg>/ui/editable}"
                        layout="ResponsiveGridLayout"
                        labelSpanXL="4" labelSpanL="4" labelSpanM="4" labelSpanS="12"
                        columnsXL="2" columnsL="2" columnsM="1">

                        <f:toolbar>
                            <Toolbar>
                                <Title text="{i18n>account}" level="H4"/>
                                <ToolbarSpacer/>
                                <Button icon="sap-icon://delete" type="Transparent"
                                        press=".onRemoveSecondaryAccount" tooltip="{i18n>btnRemove}"
                                        visible="{reg>/ui/editable}"/>
                            </Toolbar>
                        </f:toolbar>

                        <f:content>
                            <Label text="{i18n>paymentMethod}" required="true"/>
                            <!-- Same vendor type, so the same allowed set as the
                                 primary account. -->
                            <SegmentedButton
                                selectedKey="{reg>method}"
                                enabled="{reg>/ui/editable}"
                                items="{reg>/ui/paymentMethods}">
                                <items>
                                    <SegmentedButtonItem key="{reg>key}" text="{reg>text}"/>
                                </items>
                            </SegmentedButton>

                            <!-- Bank country - hidden for US-only scope -->
                            <Label text="{i18n>bankCountry}" required="true" visible="false"/>
                            <Select selectedKey="{reg>country}" visible="false"
                                    enabled="{reg>/ui/editable}">
                                <items>
                                    <core:Item key="US"    text="United States"/>
                                    <core:Item key="CA"    text="Canada"/>
                                    <core:Item key="GB"    text="United Kingdom"/>
                                    <core:Item key="OTHER" text="Other"/>
                                </items>
                            </Select>

                            <Label text="{i18n>bankRoutingNum}" required="true"/>
                            <Input value="{reg>routingNum}" maxLength="9"
                                   editable="{reg>/ui/editable}"/>
                            <Label text="{i18n>bankAccountNum}" required="true"/>
                            <Input value="{reg>accountNum}" maxLength="17"
                                   editable="{reg>/ui/editable}"/>
                            <Label text="{i18n>accountHolderName}" required="true"/>
                            <Input value="{reg>holderName}"
                                   editable="{reg>/ui/editable}"/>
                        </f:content>
                    </f:SimpleForm>
                </CustomListItem>
            </List>
        </Panel>

        <Panel headerText="{i18n>paymentNotifications}" expandable="true" expanded="false">

            <VBox class="sapUiMediumMargin">
                <HBox alignItems="End" visible="{reg>/ui/editable}">
                    <Input
                        id="newNotificationEmail"
                        value="{reg>/ui/newNotificationEmail}"
                        placeholder="{i18n>emailAddress}"
                        type="Email"
                        liveChange=".onNotificationEmailChange"
                        valueState="{= ${reg>/ui/notificationEmailError} ? 'Error' : 'None'}"
                        valueStateText="{i18n>invalidEmailFormat}"
                        class="sapUiTinyMarginEnd"/>
                    <Button icon="sap-icon://add" tooltip="{i18n>btnAddEmailContact}"
                            press=".onAddNotificationEmail" type="Transparent"/>
                </HBox>

                <List
                    id="notificationEmailList"
                    items="{reg>/banking/paymentNotifications}"
                    noDataText="{i18n>noNotificationEmails}"
                    class="sapUiSmallMarginTop">
                    <CustomListItem>
                        <HBox justifyContent="SpaceBetween" alignItems="Center" width="100%">
                            <HBox alignItems="Center">
                                <core:Icon src="sap-icon://email" class="sapUiTinyMarginEnd"/>
                                <Text text="{reg>email}"/>
                            </HBox>
                            <Button icon="sap-icon://delete" type="Transparent"
                                    press=".onRemoveNotificationEmail" tooltip="{i18n>btnRemove}"
                                    visible="{reg>/ui/editable}"/>
                        </HBox>
                    </CustomListItem>
                </List>
            </VBox>
        </Panel>

    </VBox>

</mvc:View>
