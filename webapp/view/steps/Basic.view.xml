<mvc:View
    controllerName="vsnt.vera.controller.steps.Basic"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:f="sap.ui.layout.form"
    xmlns:core="sap.ui.core">

    <VBox class="sapUiMediumMargin">

        <f:SimpleForm
            title="{i18n>vendorName}"
            editable="{reg>/ui/editable}"
            layout="ResponsiveGridLayout"
            labelSpanXL="4" labelSpanL="4" labelSpanM="4" labelSpanS="12"
            adjustLabelSpan="false"
            emptySpanXL="0" emptySpanL="0" emptySpanM="0" emptySpanS="0"
            columnsXL="2" columnsL="2" columnsM="1">

            <f:content>
                <Label text="{i18n>legalName}" required="true"/>
                <Input id="legalName" value="{reg>/basic/legalName}" liveChange=".onBasicFieldChange"
                       editable="{reg>/ui/editable}"
                       valueState="{= ${reg>/ui/basicTouched} &amp;&amp; !${reg>/basic/legalName} ? 'Error' : 'None'}"
                       valueStateText="Legal Name is required"/>

                <Label text="{i18n>invoicingName}"/>
                <Input id="invoicingName" value="{reg>/basic/invoicingName}" liveChange=".onBasicFieldChange"
                       editable="{reg>/ui/editable}"/>
            </f:content>
        </f:SimpleForm>

        <f:SimpleForm
            title="{i18n>additionalInformation}"
            editable="{reg>/ui/editable}"
            layout="ResponsiveGridLayout"
            labelSpanXL="4" labelSpanL="4" labelSpanM="4" labelSpanS="12"
            adjustLabelSpan="false"
            columnsXL="2" columnsL="2" columnsM="1">

            <f:content>
                <!-- TODO: re-enable Vendor Type when needed
                <Label text="Vendor Type" required="true"/>
                <Select id="vendorType" selectedKey="{reg>/vendorType}" change=".onVendorTypeChange"
                        valueState="{= ${reg>/ui/basicTouched} &amp;&amp; !${reg>/vendorType} ? 'Error' : 'None'}"
                        valueStateText="Vendor Type is required">
                    <core:Item key=""    text="Select Vendor Type"/>
                    <core:Item key="010" text="Trade Vendor"/>
                    <core:Item key="018" text="Production/Agreement"/>
                    <core:Item key="020" text="Freelancer/Talent/Statistician"/>
                    <core:Item key="030" text="Charitable"/>
                    <core:Item key="040" text="Political Contribution"/>
                    <core:Item key="050" text="Government"/>
                    <core:Item key="060" text="One Time - Refund/Reimbursement"/>
                    <core:Item key="093" text="One Time - Legal Settlement"/>
                    <core:Item key="094" text="One Time - Contest Winner"/>
                    <core:Item key="095" text="One Time - Posthumous Payments"/>
                    <core:Item key="080" text="Utility"/>
                    <core:Item key="090" text="Comcast"/>
                    <core:Item key="091" text="Revenue Share"/>
                    <core:Item key="092" text="Garnishment"/>
                </Select>
                -->

                <Label text="{i18n>acceptPO}"/>
                <CheckBox id="acceptPO" selected="{reg>/basic/acceptPO}" select=".onAcceptPOChange"
                          enabled="{reg>/ui/editable}"/>

                <Label text="{i18n>poEmailPlaceholder}" required="true" visible="{reg>/basic/acceptPO}"/>
                <Input id="poEmail" value="{reg>/basic/poEmail}" type="Email"
                       visible="{reg>/basic/acceptPO}" liveChange=".onBasicFieldChange"
                       editable="{reg>/ui/editable}"
                       valueState="{= ${reg>/ui/basicTouched} &amp;&amp; ${reg>/basic/acceptPO} &amp;&amp; !${reg>/basic/poEmail} ? 'Error' : 'None'}"
                       valueStateText="PO Email is required when accepting purchase orders"/>
            </f:content>
        </f:SimpleForm>

        <f:SimpleForm
            title="{i18n>primaryAddress}"
            editable="{reg>/ui/editable}"
            layout="ResponsiveGridLayout"
            labelSpanXL="4" labelSpanL="4" labelSpanM="4" labelSpanS="12"
            adjustLabelSpan="false"
            columnsXL="2" columnsL="2" columnsM="1">

            <f:content>
                <Label text="{i18n>country}" required="true"/>
                <Select id="country" selectedKey="{reg>/basic/primaryAddress/country}"
                        forceSelection="false"
                        enabled="{reg>/ui/editable}"
                        valueState="{= ${reg>/ui/basicTouched} &amp;&amp; !${reg>/basic/primaryAddress/country} ? 'Error' : 'None'}"
                        valueStateText="Country is required"
                        items="{ref>/countries}" change=".onCountryChange">
                    <core:ListItem key="{ref>country}" text="{ref>description}"/>
                </Select>

                <Label text="{i18n>address1}" required="true"/>
                <Input id="address1" value="{reg>/basic/primaryAddress/address1}" liveChange=".onBasicFieldChange"
                       editable="{reg>/ui/editable}"
                       valueState="{= ${reg>/ui/basicTouched} &amp;&amp; !${reg>/basic/primaryAddress/address1} ? 'Error' : 'None'}"
                       valueStateText="Address Line 1 is required"/>

                <Label text="{i18n>address2}"/>
                <Input id="address2" value="{reg>/basic/primaryAddress/address2}" liveChange=".onBasicFieldChange"
                       editable="{reg>/ui/editable}"/>

                <Label text="{i18n>address3}"/>
                <Input id="address3" value="{reg>/basic/primaryAddress/address3}" liveChange=".onBasicFieldChange"
                       editable="{reg>/ui/editable}"/>

                <Label text="{i18n>city}" required="true"/>
                <Input id="city" value="{reg>/basic/primaryAddress/city}" liveChange=".onBasicFieldChange"
                       editable="{reg>/ui/editable}"
                       valueState="{= ${reg>/ui/basicTouched} &amp;&amp; !${reg>/basic/primaryAddress/city} ? 'Error' : 'None'}"
                       valueStateText="City is required"/>

                <Label text="{i18n>state}" required="true"/>
                <Select id="state" selectedKey="{reg>/basic/primaryAddress/state}"
                        forceSelection="false"
                        enabled="{reg>/ui/editable}"
                        valueState="{= ${reg>/ui/basicTouched} &amp;&amp; !${reg>/basic/primaryAddress/state} ? 'Error' : 'None'}"
                        valueStateText="State is required"
                        items="{ref>/regions}" change=".onBasicFieldChange">
                    <core:ListItem key="{ref>region}" text="{ref>description}"/>
                </Select>

                <Label text="{i18n>zipCode}" required="true"/>
                <Input id="zip" value="{reg>/basic/primaryAddress/zip}"
                       liveChange=".onBasicFieldChange" change=".onZipChange"
                       editable="{reg>/ui/editable}"
                       valueState="{= ${reg>/ui/basicTouched} &amp;&amp; !${reg>/basic/primaryAddress/zip} ? 'Error' : 'None'}"
                       valueStateText="Zip Code is required"/>
            </f:content>
        </f:SimpleForm>

        <Panel
            headerText="{i18n>secondaryAddresses}"
            expandable="true"
            expanded="{= ${reg>/basic/secondaryAddresses}.length > 0 }"
            class="sapUiResponsiveMargin">

            <headerToolbar>
                <OverflowToolbar>
                    <Title text="{i18n>secondaryAddresses}" level="H3"/>
                    <ToolbarSpacer/>
                    <Select id="secondaryAddressType" selectedKey="" width="10rem"
                            visible="{reg>/ui/editable}">
                        <items>
                            <core:Item key=""         text="{i18n>selectOne}"/>
                            <core:Item key="MAILING"  text="Mailing"/>
                            <core:Item key="BILLING"  text="Billing"/>
                            <core:Item key="SHIPPING" text="Shipping"/>
                            <core:Item key="OTHER"    text="Other"/>
                        </items>
                    </Select>
                    <Button icon="sap-icon://add" tooltip="{i18n>btnAddAddress}"
                            press=".onAddSecondaryAddress" type="Transparent"
                            visible="{reg>/ui/editable}"/>
                </OverflowToolbar>
            </headerToolbar>

            <List id="secondaryAddressList"
                  items="{reg>/basic/secondaryAddresses}"
                  noDataText="{i18n>noSecondaryAddresses}"
                  showSeparators="Inner">
                <CustomListItem>
                    <f:SimpleForm
                        editable="{reg>/ui/editable}"
                        layout="ResponsiveGridLayout"
                        labelSpanXL="4" labelSpanL="4" labelSpanM="4" labelSpanS="12"
                        columnsXL="2" columnsL="2" columnsM="1">

                        <f:toolbar>
                            <Toolbar>
                                <Title text="{reg>type}" level="H4"/>
                                <ToolbarSpacer/>
                                <Button icon="sap-icon://delete" type="Transparent"
                                        press=".onRemoveSecondaryAddress" tooltip="{i18n>btnRemove}"
                                        visible="{reg>/ui/editable}"/>
                            </Toolbar>
                        </f:toolbar>

                        <f:content>
                            <Label text="{i18n>address1}" required="true"/>
                            <Input value="{reg>address1}" liveChange=".onBasicFieldChange"
                                   editable="{reg>/ui/editable}"/>
                            <Label text="{i18n>city}" required="true"/>
                            <Input value="{reg>city}" liveChange=".onBasicFieldChange"
                                   editable="{reg>/ui/editable}"/>
                            <Label text="{i18n>state}" required="true"/>
                            <Input value="{reg>state}" liveChange=".onBasicFieldChange"
                                   editable="{reg>/ui/editable}"/>
                            <Label text="{i18n>zipCode}" required="true"/>
                            <Input value="{reg>zip}" liveChange=".onBasicFieldChange"
                                   editable="{reg>/ui/editable}"/>
                        </f:content>
                    </f:SimpleForm>
                </CustomListItem>
            </List>
        </Panel>

    </VBox>

</mvc:View>
