<mvc:View
    controllerName="vsnt.vera.controller.steps.CompanyApprover"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:f="sap.ui.layout.form"
    xmlns:core="sap.ui.core">

    <VBox class="sapUiSmallMargin">

        <!-- Company Code Selection -->
        <f:SimpleForm
            editable="{reg>/ui/editable}"
            layout="ResponsiveGridLayout"
            labelSpanXL="3" labelSpanL="3" labelSpanM="3" labelSpanS="12"
            emptySpanXL="4" emptySpanL="4" emptySpanM="4"
            columnsXL="1" columnsL="1" columnsM="1">
            <f:toolbar>
                <Toolbar>
                    <Title text="{i18n>companyCodes}" level="H4"/>
                </Toolbar>
            </f:toolbar>
            <f:content>
                <Label text="{i18n>searchCompanyCode}" required="true"/>
                <HBox>
                    <Input
                        id="companyCodeInput"
                        placeholder="{i18n>companyCodePlaceholder}"
                        maxLength="4"
                        width="10rem"
                        editable="{reg>/ui/editable}"
                        submit=".onSearchCompanyCodes"/>
                    <Button
                        text="{i18n>btnSearch}"
                        icon="sap-icon://search"
                        press=".onSearchCompanyCodes"
                        visible="{reg>/ui/editable}"
                        class="sapUiSmallMarginBegin"/>
                </HBox>

                <Label text="{i18n>selectedCompanyCodes}"/>
                <Tokenizer id="companyCodeTokenizer"
                    editable="{reg>/ui/editable}"
                    tokenDelete=".onCompanyCodeRemove">
                </Tokenizer>

                <Label text=""/>
                <MessageStrip
                    text="{i18n>companyCodeRequired}"
                    type="Warning"
                    showIcon="true"
                    visible="{= ${reg>/ui/companyApproverTouched} &amp;&amp; ${reg>/companyCodes}.length === 0}"/>
            </f:content>
        </f:SimpleForm>

        <!-- Approver Selection -->
        <f:SimpleForm
            editable="{reg>/ui/editable}"
            layout="ResponsiveGridLayout"
            labelSpanXL="3" labelSpanL="3" labelSpanM="3" labelSpanS="12"
            emptySpanXL="4" emptySpanL="4" emptySpanM="4"
            columnsXL="1" columnsL="1" columnsM="1">
            <f:toolbar>
                <Toolbar>
                    <Title text="{i18n>approverSelection}" level="H4"/>
                </Toolbar>
            </f:toolbar>
            <f:content>
                <!-- TODO: set required="true" and restore valueState when approver is required again -->
                <Label text="{i18n>approver}"/>
                <Select id="approverSelect"
                    selectedKey="{reg>/approverSSO}"
                    enabled="{= ${reg>/ui/editable} &amp;&amp; ${reg>/companyCodes}.length > 0}"
                    change=".onApproverChange">
                    <items>
                        <core:Item key="" text="{i18n>selectOne}"/>
                    </items>
                </Select>
            </f:content>
        </f:SimpleForm>

    </VBox>

</mvc:View>
