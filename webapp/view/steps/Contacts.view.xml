<mvc:View
    controllerName="vsnt.vera.controller.steps.Contacts"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:f="sap.ui.layout.form"
    xmlns:core="sap.ui.core">

    <VBox class="sapUiMediumMargin">

        <Panel headerText="{i18n>tabContacts}">

            <headerToolbar>
                <OverflowToolbar>
                    <Title text="{i18n>tabContacts}" level="H3"/>
                    <ToolbarSpacer/>
                    <Button icon="sap-icon://add" text="{i18n>btnAddContact}"
                            press=".onAddContact" type="Transparent"
                            visible="{reg>/ui/editable}"/>
                </OverflowToolbar>
            </headerToolbar>

            <MessageStrip
                text="{i18n>contactsHint}"
                type="Information"
                showIcon="true"
                visible="{= !${reg>/ui/contactsTouched} &amp;&amp; ${reg>/contacts/items}.length === 0}"
                class="sapUiSmallMargin"/>

            <MessageStrip
                text="At least one contact is required"
                type="Error"
                showIcon="true"
                visible="{= ${reg>/ui/contactsTouched} &amp;&amp; ${reg>/contacts/items}.length === 0}"
                class="sapUiSmallMargin"/>

            <List
                id="contactsList"
                items="{reg>/contacts/items}"
                noDataText="{i18n>noContacts}"
                showSeparators="Inner">
                <CustomListItem>
                    <f:SimpleForm
                        editable="{reg>/ui/editable}"
                        layout="ResponsiveGridLayout"
                        labelSpanXL="4" labelSpanL="4" labelSpanM="4" labelSpanS="12"
                        columnsXL="2" columnsL="2" columnsM="1">

                        <f:toolbar>
                            <Toolbar>
                                <Title text="{reg>name}" level="H4"/>
                                <ToolbarSpacer/>
                                <Button icon="sap-icon://delete" type="Transparent"
                                        press=".onRemoveContact" tooltip="{i18n>btnRemove}"
                                        visible="{reg>/ui/editable}"/>
                            </Toolbar>
                        </f:toolbar>

                        <f:content>
                            <Label text="{i18n>name}" required="true"/>
                            <Input value="{reg>name}" liveChange=".onContactFieldChange"
                                   editable="{reg>/ui/editable}"
                                   valueState="{= ${reg>/ui/contactsTouched} &amp;&amp; !${reg>name} ? 'Error' : 'None'}"
                                   valueStateText="Contact name is required"/>
                            <Label text="{i18n>emailAddress}" required="true"/>
                            <Input value="{reg>email}" type="Email" liveChange=".onContactFieldChange"
                                   editable="{reg>/ui/editable}"
                                   valueState="{= ${reg>/ui/contactsTouched} &amp;&amp; !${reg>email} ? 'Error' : 'None'}"
                                   valueStateText="Valid email address is required"/>
                            <Label text="{i18n>phoneNumber}"/>
                            <Input value="{reg>phone}" type="Tel" editable="{reg>/ui/editable}"/>
                            <Label text="{i18n>faxNumber}"/>
                            <Input value="{reg>fax}" type="Tel" editable="{reg>/ui/editable}"/>
                            <!-- ABTNR, the SAP contact department codes, ported
                                 verbatim from tools.java setupContactDepartmentArray.
                                 The keys have to be these: ABTNR is what a loaded
                                 request carries and what the save writes back. -->
                            <Label text="{i18n>department}"/>
                            <Select selectedKey="{reg>department}" enabled="{reg>/ui/editable}"
                                    forceSelection="false">
                                <items>
                                    <core:Item key=""     text="{i18n>selectOne}"/>
                                    <core:Item key="0001" text="Managing Director"/>
                                    <core:Item key="0002" text="Purchasing"/>
                                    <core:Item key="0003" text="Sales"/>
                                    <core:Item key="0004" text="Organization"/>
                                    <core:Item key="0005" text="Administration"/>
                                    <core:Item key="0006" text="Production"/>
                                    <core:Item key="0007" text="Quality assurance"/>
                                    <core:Item key="0008" text="Secretaries"/>
                                    <core:Item key="0009" text="Financial department"/>
                                    <core:Item key="0010" text="Legal department"/>
                                    <core:Item key="0011" text="Applier"/>
                                    <core:Item key="0012" text="Collection"/>
                                    <core:Item key="0013" text="Credit"/>
                                    <core:Item key="0014" text="Ship To"/>
                                    <core:Item key="0015" text="Inv C/O"/>
                                    <core:Item key="0016" text="Indirect Customer"/>
                                    <core:Item key="0017" text="Trade Spend"/>
                                    <core:Item key="0018" text="Treasury"/>
                                    <core:Item key="0019" text="Media Buying"/>
                                    <core:Item key="0020" text="Collection - DIGITAL"/>
                                    <core:Item key="0021" text="Collection - NETWORK"/>
                                    <core:Item key="0022" text="Collection - CABLE"/>
                                    <core:Item key="0023" text="Collection - TVS"/>
                                    <core:Item key="ZALT" text="Alternate Billing"/>
                                    <core:Item key="ZCFS" text="CFS Department"/>
                                </items>
                            </Select>
                        </f:content>
                    </f:SimpleForm>
                </CustomListItem>
            </List>

        </Panel>

    </VBox>

</mvc:View>
