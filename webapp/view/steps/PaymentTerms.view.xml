<mvc:View
    controllerName="vsnt.vera.controller.steps.PaymentTerms"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:f="sap.ui.layout.form"
    xmlns:core="sap.ui.core">

    <VBox class="sapUiMediumMargin">

        <f:SimpleForm
            title="{i18n>paymentTermsTitle}"
            editable="{reg>/ui/editable}"
            layout="ResponsiveGridLayout"
            labelSpanXL="4" labelSpanL="4" labelSpanM="4" labelSpanS="12"
            adjustLabelSpan="false"
            columnsXL="2" columnsL="2" columnsM="1">

            <f:content>
                <Label text="{i18n>paymentTermsTitle}" required="true"/>
                <Select
                    id="paymentTermsSelect"
                    selectedKey="{reg>/paymentTerms/selected}"
                    items="{reg>/paymentTerms/availableTerms}"
                    change=".onPaymentTermSelect"
                    forceSelection="false"
                    enabled="{reg>/ui/editable}"
                    valueState="{= ${reg>/ui/paymentTermsTouched} &amp;&amp; !${reg>/paymentTerms/selected} ? 'Error' : 'None'}"
                    valueStateText="Payment Term is required">
                    <core:ListItem key="{reg>Key}" text="{reg>Description}"/>
                </Select>
            </f:content>
        </f:SimpleForm>

    </VBox>

</mvc:View>
