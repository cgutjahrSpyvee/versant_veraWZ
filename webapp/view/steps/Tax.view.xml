<mvc:View
    controllerName="vsnt.vera.controller.steps.Tax"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:f="sap.ui.layout.form"
    xmlns:u="sap.ui.unified"
    xmlns:core="sap.ui.core">

    <VBox class="sapUiMediumMargin">

        <f:SimpleForm
            title="{i18n>taxClassification}"
            editable="true"
            layout="ResponsiveGridLayout"
            labelSpanXL="4" labelSpanL="4" labelSpanM="4" labelSpanS="12"
            adjustLabelSpan="false"
            columnsXL="2" columnsL="2" columnsM="1">

            <f:content>
                <Label text="{i18n>entityOrIndividual}" required="true"/>
                <RadioButtonGroup
                    id="entityTypeGroup"
                    selectedIndex="{= ${reg>/tax/entityType} === 'Entity' ? 0 : 1}"
                    select=".onEntityTypeSelect"
                    columns="2">
                    <buttons>
                        <RadioButton id="rbEntity"     text="{i18n>entity}"/>
                        <RadioButton id="rbIndividual" text="{i18n>individual}"/>
                    </buttons>
                </RadioButtonGroup>

                <!-- US Person toggle - hidden for US-only scope, will be re-enabled for international -->
                <Label text="{i18n>usCitizenQuestion}" required="true" visible="false"/>
                <RadioButtonGroup
                    id="usCitizenGroup"
                    selectedIndex="{= ${reg>/tax/isUSPerson} ? 0 : 1}"
                    select=".onUSPersonSelect"
                    columns="2"
                    visible="false">
                    <buttons>
                        <RadioButton id="rbUSYes" text="{i18n>yesUSPerson}"/>
                        <RadioButton id="rbUSNo"  text="{i18n>noUSPerson}"/>
                    </buttons>
                </RadioButtonGroup>
            </f:content>
        </f:SimpleForm>

        <f:SimpleForm
            title="{i18n>w9SectionTitle}"
            editable="true"
            layout="ResponsiveGridLayout"
            labelSpanXL="4" labelSpanL="4" labelSpanM="4" labelSpanS="12"
            adjustLabelSpan="false"
            columnsXL="1" columnsL="1" columnsM="1">

            <f:content>
                <Label text="{i18n>uploadW9Label}"/>
                <HBox alignItems="Center">
                    <u:FileUploader
                        id="w9Uploader"
                        name="w9"
                        fileType="pdf"
                        maximumFileSize="10"
                        change=".onW9FileChange"
                        typeMismatch=".onFileTypeMismatch"
                        buttonText="{i18n>chooseFile}"/>
                    <ObjectStatus
                        text="{reg>/tax/w9FileName}"
                        state="Success"
                        icon="sap-icon://document"
                        visible="{= !!${reg>/tax/w9FileName}}"
                        class="sapUiSmallMarginBegin"/>
                </HBox>

                <Label text=""/>
                <Link
                    id="w9DownloadLink"
                    text="{i18n>downloadBlankW9}"
                    target="_blank"/>
            </f:content>
        </f:SimpleForm>

        <MessageStrip
            text="{i18n>notice590Text}"
            type="Warning"
            showIcon="true"
            showCloseButton="false"
            visible="{= !${reg>/tax/isUSPerson}}"
            class="sapUiMediumMarginTopBottom"/>

        <f:SimpleForm
            title="{i18n>notice590Title}"
            editable="true"
            layout="ResponsiveGridLayout"
            labelSpanXL="4" labelSpanL="4" labelSpanM="4" labelSpanS="12"
            adjustLabelSpan="false"
            columnsXL="1" columnsL="1" columnsM="1"
            visible="{= !${reg>/tax/isUSPerson}}">

            <f:content>
                <Label text="{i18n>upload590}"/>
                <HBox alignItems="Center">
                    <u:FileUploader
                        id="uploader590"
                        name="590"
                        fileType="pdf"
                        maximumFileSize="10"
                        change=".on590FileChange"
                        typeMismatch=".onFileTypeMismatch"
                        buttonText="{i18n>chooseFile}"/>
                    <ObjectStatus
                        text="{reg>/tax/doc590Name}"
                        state="Success"
                        icon="sap-icon://document"
                        visible="{= !!${reg>/tax/doc590Name}}"
                        class="sapUiSmallMarginBegin"/>
                </HBox>

                <Label text=""/>
                <Link
                    text="{i18n>downloadBlank590}"
                    href="/irj/go/km/docs/vsnt_km/Vendor%20Portal/Documents/590_Blank.pdf"
                    target="_blank"
                    icon="sap-icon://download"/>
            </f:content>
        </f:SimpleForm>

        <f:SimpleForm
            title="{i18n>taxCategoryTitle}"
            editable="true"
            layout="ResponsiveGridLayout"
            labelSpanXL="4" labelSpanL="4" labelSpanM="4" labelSpanS="12"
            adjustLabelSpan="false"
            columnsXL="2" columnsL="2" columnsM="1">

            <f:content>
                <Label text="{i18n>taxIdType}" required="true"/>
                <SegmentedButton
                    selectedKey="{reg>/tax/taxCategory}"
                    selectionChange=".onTaxCategoryChange">
                    <items>
                        <SegmentedButtonItem key="TaxID" text="{i18n>taxID}"/>
                        <SegmentedButtonItem key="SSN"   text="{i18n>socialSecurityNumber}"/>
                    </items>
                </SegmentedButton>

                <Label text="{i18n>enterTaxIDNumber}" required="true"
                       visible="{= ${reg>/tax/taxCategory} === 'TaxID'}"/>
                <Input
                    id="taxIdNumber"
                    value="{reg>/tax/taxIdNumber}"
                    valueState="{= ${reg>/ui/taxTouched} &amp;&amp; !${reg>/tax/taxIdNumber} ? 'Error' : 'None'}"
                    valueStateText="Tax ID is required"
                    maxLength="10"
                    visible="{= ${reg>/tax/taxCategory} === 'TaxID'}"
                    liveChange=".onTaxFieldChange"
                    change=".onTaxIdBlur"/>

                <Label text="{i18n>enterSSN}" required="true"
                       visible="{= ${reg>/tax/taxCategory} === 'SSN'}"/>
                <Input
                    id="ssnNumber"
                    value="{reg>/tax/ssnNumber}"
                    valueState="{= ${reg>/ui/taxTouched} &amp;&amp; !${reg>/tax/ssnNumber} ? 'Error' : 'None'}"
                    valueStateText="SSN is required"
                    maxLength="11"
                    type="Password"
                    visible="{= ${reg>/tax/taxCategory} === 'SSN'}"
                    liveChange=".onTaxFieldChange"/>

                <Label text="{i18n>recipientType}" required="true"/>
                <Select id="recipientType" selectedKey="{reg>/tax/recipientType}"
                        valueState="{= ${reg>/ui/taxTouched} &amp;&amp; !${reg>/tax/recipientType} ? 'Error' : 'None'}"
                        valueStateText="Recipient Type is required"
                        change=".onTaxFieldChange">
                    <items>
                        <core:Item key=""   text="{i18n>selectOne}"/>
                        <core:Item key="01" text="Individual / Sole Proprietor"/>
                        <core:Item key="02" text="C Corporation"/>
                        <core:Item key="03" text="S Corporation"/>
                        <core:Item key="04" text="Partnership"/>
                        <core:Item key="05" text="Trust / Estate"/>
                        <core:Item key="06" text="Limited Liability Company"/>
                        <core:Item key="07" text="Other"/>
                    </items>
                </Select>

                <Label text="{i18n>exemptPayeeCode}" required="true"/>
                <Select id="exemptPayee" selectedKey="{reg>/tax/exemptPayeeCode}"
                        valueState="{= ${reg>/ui/taxTouched} &amp;&amp; !${reg>/tax/exemptPayeeCode} ? 'Error' : 'None'}"
                        valueStateText="Exempt Payee Code is required"
                        change=".onTaxFieldChange">
                    <items>
                        <core:Item key=""   text="{i18n>selectOne}"/>
                        <core:Item key="14" text="Not Applicable"/>
                        <core:Item key="1"  text="1 - An organization exempt from tax under section 501(a)"/>
                        <core:Item key="2"  text="2 - The United States or any of its agencies or instrumentalities"/>
                        <core:Item key="3"  text="3 - A state, the District of Columbia, or a US possession"/>
                        <core:Item key="4"  text="4 - A foreign government or any of its political subdivisions"/>
                        <core:Item key="5"  text="5 - A corporation"/>
                        <core:Item key="6"  text="6 - A dealer in securities or commodities"/>
                        <core:Item key="7"  text="7 - A futures commission merchant"/>
                        <core:Item key="8"  text="8 - A real estate investment trust"/>
                        <core:Item key="9"  text="9 - An entity registered under the Investment Company Act of 1940"/>
                        <core:Item key="10" text="10 - A common trust fund operated by a bank under section 584(a)"/>
                        <core:Item key="11" text="11 - A financial institution"/>
                        <core:Item key="12" text="12 - A middleman known as a nominee or custodian"/>
                        <core:Item key="13" text="13 - A trust exempt from tax under section 664 or described in section 4947"/>
                    </items>
                </Select>
            </f:content>
        </f:SimpleForm>

    </VBox>

</mvc:View>
