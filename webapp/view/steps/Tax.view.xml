<mvc:View
    controllerName="vsnt.vera.controller.steps.Tax"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:f="sap.ui.layout.form"
    xmlns:u="sap.ui.unified"
    xmlns:core="sap.ui.core">

    <VBox class="sapUiMediumMargin">

        <f:SimpleForm
            title="{i18n>taxClassification}"
            editable="true"
            layout="ResponsiveGridLayout"
            labelSpanXL="4" labelSpanL="4" labelSpanM="4" labelSpanS="12"
            adjustLabelSpan="false"
            columnsXL="2" columnsL="2" columnsM="1">

            <f:content>
                <Label text="{i18n>entityOrIndividual}" required="true"/>
                <RadioButtonGroup
                    id="entityTypeGroup"
                    selectedIndex="{= ${reg>/tax/entityType} === 'Entity' ? 0 : 1}"
                    select=".onEntityTypeSelect"
                    columns="2">
                    <buttons>
                        <RadioButton id="rbEntity"     text="{i18n>entity}"/>
                        <RadioButton id="rbIndividual" text="{i18n>individual}"/>
                    </buttons>
                </RadioButtonGroup>

                <Label text="{i18n>usCitizenQuestion}" required="true"/>
                <RadioButtonGroup
                    id="usCitizenGroup"
                    selectedIndex="{= ${reg>/tax/isUSPerson} ? 0 : 1}"
                    select=".onUSPersonSelect"
                    columns="2">
                    <buttons>
                        <RadioButton id="rbUSYes" text="{i18n>yesUSPerson}"/>
                        <RadioButton id="rbUSNo"  text="{i18n>noUSPerson}"/>
                    </buttons>
                </RadioButtonGroup>
            </f:content>
        </f:SimpleForm>

        <f:SimpleForm
            title="{i18n>w9SectionTitle}"
            editable="true"
            layout="ResponsiveGridLayout"
            labelSpanXL="4" labelSpanL="4" labelSpanM="4" labelSpanS="12"
            adjustLabelSpan="false"
            columnsXL="1" columnsL="1" columnsM="1">

            <f:content>
                <Label text="{i18n>uploadW9Label}" required="true"/>
                <HBox alignItems="Center">
                    <u:FileUploader
                        id="w9Uploader"
                        name="w9"
                        fileType="pdf"
                        maximumFileSize="10"
                        change=".onW9FileChange"
                        typeMismatch=".onFileTypeMismatch"
                        buttonText="{i18n>chooseFile}"/>
                    <ObjectStatus
                        text="{reg>/tax/w9FileName}"
                        state="Success"
                        icon="sap-icon://document"
                        visible="{= !!${reg>/tax/w9FileName}}"
                        class="sapUiSmallMarginBegin"/>
                </HBox>

                <Label text=""/>
                <Link
                    text="{i18n>downloadBlankW9}"
                    href="/irj/go/km/docs/nbcu_km/Vendor%20Portal/Documents/W9_Blank.pdf"
                    target="_blank"
                    icon="sap-icon://download"/>
            </f:content>
        </f:SimpleForm>

        <MessageStrip
            text="{i18n>notice590Text}"
            type="Warning"
            showIcon="true"
            showCloseButton="false"
            visible="{= !${reg>/tax/isUSPerson}}"
            class="sapUiMediumMarginTopBottom"/>

        <f:SimpleForm
            title="{i18n>notice590Title}"
            editable="true"
            layout="ResponsiveGridLayout"
            labelSpanXL="4" labelSpanL="4" labelSpanM="4" labelSpanS="12"
            adjustLabelSpan="false"
            columnsXL="1" columnsL="1" columnsM="1"
            visible="{= !${reg>/tax/isUSPerson}}">

            <f:content>
                <Label text="{i18n>upload590}" required="true"/>
                <HBox alignItems="Center">
                    <u:FileUploader
                        id="uploader590"
                        name="590"
                        fileType="pdf"
                        maximumFileSize="10"
                        change=".on590FileChange"
                        typeMismatch=".onFileTypeMismatch"
                        buttonText="{i18n>chooseFile}"/>
                    <ObjectStatus
                        text="{reg>/tax/doc590Name}"
                        state="Success"
                        icon="sap-icon://document"
                        visible="{= !!${reg>/tax/doc590Name}}"
                        class="sapUiSmallMarginBegin"/>
                </HBox>

                <Label text=""/>
                <Link
                    text="{i18n>downloadBlank590}"
                    href="/irj/go/km/docs/nbcu_km/Vendor%20Portal/Documents/590_Blank.pdf"
                    target="_blank"
                    icon="sap-icon://download"/>
            </f:content>
        </f:SimpleForm>

        <f:SimpleForm
            title="{i18n>taxCategoryTitle}"
            editable="true"
            layout="ResponsiveGridLayout"
            labelSpanXL="4" labelSpanL="4" labelSpanM="4" labelSpanS="12"
            adjustLabelSpan="false"
            columnsXL="2" columnsL="2" columnsM="1">

            <f:content>
                <Label text="{i18n>taxIdType}" required="true"/>
                <SegmentedButton
                    selectedKey="{reg>/tax/taxCategory}"
                    selectionChange=".onTaxCategoryChange">
                    <items>
                        <SegmentedButtonItem key="TaxID" text="{i18n>taxID}"/>
                        <SegmentedButtonItem key="SSN"   text="{i18n>socialSecurityNumber}"/>
                    </items>
                </SegmentedButton>

                <Label text="{i18n>enterTaxIDNumber}" required="true"
                       visible="{= ${reg>/tax/taxCategory} === 'TaxID'}"/>
                <Input
                    id="taxIdNumber"
                    value="{reg>/tax/taxIdNumber}"
                    maxLength="10"
                    visible="{= ${reg>/tax/taxCategory} === 'TaxID'}"
                    liveChange=".onTaxFieldChange"
                    change=".onTaxIdBlur"/>

                <Label text="{i18n>enterSSN}" required="true"
                       visible="{= ${reg>/tax/taxCategory} === 'SSN'}"/>
                <Input
                    id="ssnNumber"
                    value="{reg>/tax/ssnNumber}"
                    maxLength="11"
                    type="Password"
                    visible="{= ${reg>/tax/taxCategory} === 'SSN'}"
                    liveChange=".onTaxFieldChange"/>

                <Label text="{i18n>recipientType}" required="true"/>
                <Select id="recipientType" selectedKey="{reg>/tax/recipientType}"
                        change=".onTaxFieldChange">
                    <items>
                        <core:Item key=""      text="{i18n>selectOne}"/>
                        <core:Item key="IND"   text="Individual/Sole Proprietor"/>
                        <core:Item key="CCORP" text="C Corporation"/>
                        <core:Item key="SCORP" text="S Corporation"/>
                        <core:Item key="PART"  text="Partnership"/>
                        <core:Item key="TRUST" text="Trust/Estate"/>
                        <core:Item key="LLC_C" text="LLC - C Corporation"/>
                        <core:Item key="LLC_S" text="LLC - S Corporation"/>
                        <core:Item key="LLC_P" text="LLC - Partnership"/>
                        <core:Item key="OTHER" text="Other"/>
                    </items>
                </Select>

                <Label text="{i18n>exemptPayeeCode}" required="true"/>
                <Select id="exemptPayee" selectedKey="{reg>/tax/exemptPayeeCode}"
                        change=".onTaxFieldChange">
                    <items>
                        <core:Item key=""  text="{i18n>selectOne}"/>
                        <core:Item key="1" text="{i18n>exempt1}"/>
                        <core:Item key="2" text="{i18n>exempt2}"/>
                        <core:Item key="3" text="{i18n>exempt3}"/>
                        <core:Item key="4" text="{i18n>exempt4}"/>
                        <core:Item key="5" text="5 - A corporation"/>
                        <core:Item key="6" text="6 - Dealer in securities or commodities"/>
                        <core:Item key="7" text="7 - Futures commission merchant"/>
                    </items>
                </Select>
            </f:content>
        </f:SimpleForm>

    </VBox>

</mvc:View>
