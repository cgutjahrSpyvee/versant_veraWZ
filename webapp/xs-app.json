{
  "welcomeFile": "/index.html",
  "authenticationMethod": "route",
  "routes": [
    {
      "comment": "Route API calls through the BTP VERA_PORTAL destination to the on-premise NetWeaver Portal.",
      "source": "^/vera-portal/(.*)",
      "target": "$1",
      "destination": "VERA_PORTAL",
      "authenticationType": "xsuaa",
      "csrfProtection": true
    },
    {
      "comment": "Serve UI5 app resources from the HTML5 Application Repository.",
      "source": "^(.*)$",
      "target": "$1",
      "service": "html5-apps-repo-rt",
      "authenticationType": "xsuaa"
    }
  ]
}
